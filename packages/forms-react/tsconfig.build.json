{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"rootDir": "./src",
		"outDir": "./dist",
		"noEmit": false,
		"declaration": true,
		"emitDeclarationOnly": true
	},
	"include": ["src"],
	"exclude": [
		"./test/**",
		"./src/stories/**",
		"**/*.test.ts",
		"**/*.test.tsx",
		"**/*.stories.ts",
		"**/*.stories.tsx",
		"**/*.play.ts"
	]
}
