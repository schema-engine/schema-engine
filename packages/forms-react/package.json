{
	"name": "@schema-engine/forms-react",
	"type": "module",
	"version": "0.1.0",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": [
		"**/*.css"
	],
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"style": "dist/global.css",
	"files": [
		"/dist/*"
	],
	"scripts": {
		"build:lib": "pnpm clean && pnpm build:files && pnpm build:types",
		"build:files": "node ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"watch:lib": "node ./build.ts --watch",
		"clean": "rm -rf ./dist",
		"test:all": "vitest run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build -o ./storybook-static",
		"check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test-types.json && tsc --noEmit -p ../../registry/shared/tsconfig.json && tsc --noEmit -p ../../registry/base-ui/tsconfig.json && tsc --noEmit -p ../../registry/aria/tsconfig.json && tsc --noEmit -p ../../registry/radix/tsconfig.json",
		"test:storybook": "vitest run --project storybook"
	},
	"devDependencies": {
		"@base-ui/react": "^1.1.0",
		"@schema-engine/forms": "workspace:*",
		"@schema-engine/scripts": "workspace:*",
		"@storybook/addon-docs": "^10.1.8",
		"@storybook/addon-vitest": "^10.1.8",
		"@storybook/react-vite": "^10.1.8",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^5.1.2",
		"@vitest/browser": "^4.0.13",
		"@vitest/browser-playwright": "^4.0.13",
		"autoprefixer": "^10.4.21",
		"cmdk": "^1.1.1",
		"date-fns": "4.1.0",
		"esbuild": "^0.27.0",
		"input-otp": "1.4.1",
		"lucide-react": "^0.539.0",
		"msw": "^2.11.6",
		"msw-storybook-addon": "^2.0.6",
		"postcss": "^8.5.26",
		"postcss-import": "^16.1.1",
		"postcss-nested": "^7.0.2",
		"react": "^19",
		"react-aria-components": "^1.13.0",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19",
		"react-dropzone": "^14.3.8",
		"react-hook-form": "^7.60.0",
		"imask": "^7.6.1",
		"libphonenumber-js": "^1.13.12",
		"react-phone-number-input": "^3.4.12",
		"remark-gfm": "^4.0.1",
		"storybook": "^10.1.8",
		"tailwindcss": "^4",
		"tsc-alias": "^1.8.16",
		"tw-animate-css": "^1.4.0",
		"vitest": "^4.0.13",
		"vitest-browser-react": "^2.0.2",
		"zod": "^4.0.17"
	},
	"peerDependencies": {
		"@schema-engine/forms": "workspace:*",
		"react": "^19",
		"react-dom": "^19",
		"react-hook-form": "^7.60.0",
		"typescript": "^5",
		"zod": "^4.0.17"
	},
	"dependencies": {
		"@ecopages/logger": "^0.2.2",
		"@schema-engine/actions": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.4.0"
	},
	"exports": {
		"./package.json": {
			"import": "./package.json"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./primitives": {
			"types": "./dist/primitives.d.ts",
			"import": "./dist/primitives.js"
		},
		"./adapters": {
			"types": "./dist/adapters/index.d.ts",
			"import": "./dist/adapters/index.js"
		},
		"./adapters/react-hook-form": {
			"types": "./dist/adapters/react-hook-form.d.ts",
			"import": "./dist/adapters/react-hook-form.js"
		},
		"./registries/builder-registry": {
			"types": "./dist/registries/builder-registry.d.ts",
			"import": "./dist/registries/builder-registry.js"
		},
		"./hooks": {
			"types": "./dist/hooks/index.d.ts",
			"import": "./dist/hooks/index.js"
		},
		"./contexts": {
			"types": "./dist/contexts/index.d.ts",
			"import": "./dist/contexts/index.js"
		},
		"./components/form-debugger": {
			"types": "./dist/components/form-debugger/index.d.ts",
			"import": "./dist/components/form-debugger/index.js"
		},
		"./global.css": "./dist/global.css",
		"./dist/*.css": "./dist/*.css"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
