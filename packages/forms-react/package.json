{
	"name": "@schema-engine/forms-react",
	"type": "module",
	"version": "0.6.0",
	"description": "The React renderer for Schema Engine forms",
	"keywords": [
		"schema-engine",
		"forms",
		"react",
		"json"
	],
	"author": "Andrea Zanenghi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/schema-engine/schema-engine.git",
		"directory": "packages/forms-react"
	},
	"homepage": "https://schema-engine.com/docs/forms-react/overview",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": [
		"**/*.css"
	],
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"/dist/*",
		"/skill"
	],
	"scripts": {
		"build:lib": "pnpm clean && pnpm build:files && pnpm build:types",
		"build:files": "node ./build.ts",
		"build:types": "tsc -p tsconfig.build.json",
		"watch:lib": "node ./build.ts --watch",
		"clean": "rm -rf ./dist",
		"test:all": "vitest run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build -o ./storybook-static",
		"check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test-types.json",
		"test:storybook": "vitest run --project storybook"
	},
	"devDependencies": {
		"@base-ui/react": "^1.1.0",
		"@schema-engine/actions": "workspace:*",
		"@schema-engine/forms": "workspace:*",
		"@schema-engine/layout": "workspace:*",
		"@schema-engine/scripts": "workspace:*",
		"@storybook/addon-docs": "^10.6.9",
		"@storybook/addon-vitest": "^10.6.9",
		"@storybook/react-vite": "^10.6.9",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^24.13.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^5.1.2",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"autoprefixer": "^10.4.21",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "4.1.0",
		"esbuild": "^0.27.0",
		"imask": "^7.6.1",
		"input-otp": "1.4.1",
		"libphonenumber-js": "^1.13.12",
		"lucide-react": "^0.539.0",
		"msw": "^2.11.6",
		"msw-storybook-addon": "^2.0.6",
		"postcss": "^8.5.26",
		"postcss-import": "^16.1.1",
		"postcss-nested": "^7.0.2",
		"react": "^19",
		"react-aria-components": "^1.13.0",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19",
		"react-dropzone": "^14.3.8",
		"react-phone-number-input": "^3.4.12",
		"remark-gfm": "^4.0.1",
		"storybook": "^10.6.9",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-react": "^2.3.0",
		"zod": "^4.5.0"
	},
	"peerDependencies": {
		"@schema-engine/forms": "workspace:^",
		"@schema-engine/layout": "workspace:^",
		"react": "^19",
		"react-dom": "^19",
		"zod": "^4.5.0"
	},
	"dependencies": {
		"@ecopages/logger": "^0.2.3",
		"@standard-schema/spec": "^1.1.0"
	},
	"exports": {
		"./package.json": {
			"import": "./package.json"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./primitives": {
			"types": "./dist/primitives.d.ts",
			"import": "./dist/primitives.js"
		},
		"./hooks": {
			"types": "./dist/hooks/index.d.ts",
			"import": "./dist/hooks/index.js"
		},
		"./debugger": {
			"types": "./dist/debugger.d.ts",
			"import": "./dist/debugger.js"
		},
		"./debugger.css": "./dist/debugger.css"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
