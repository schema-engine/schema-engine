{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vitest/globals"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false,
		"paths": {
			"@schema-engine/forms-react": ["./src/index.ts"],
			"@schema-engine/forms-react/*": ["./src/*"],
			"@/components/ui/schema-engine/components/*": [
				"../../registry/base-ui/primitives/*",
				"../../registry/shared/primitives/*"
			],
			"@/components/schema-engine/forms/*": ["../../registry/shared/forms/*"],
			"@/components/ui/*": ["../../registry/ui-stubs/*"],
			"@/lib/utils": ["../../registry/ui-stubs/lib/utils.ts"],
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": ["dist", "node_modules"]
}
