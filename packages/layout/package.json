{
	"name": "@schema-engine/layout",
	"type": "module",
	"version": "0.5.1",
	"description": "Domain-neutral layout for Schema Engine: a named grid, appearance axes and a theme compiler",
	"keywords": [
		"schema-engine",
		"layout",
		"grid",
		"theme",
		"css"
	],
	"author": "Andrea Zanenghi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/schema-engine/schema-engine.git",
		"directory": "packages/layout"
	},
	"engines": {
		"node": "^24.22.0 || >=26.0.0"
	},
	"homepage": "https://schema-engine.com/docs/layout/overview",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		"./package.json": {
			"import": "./package.json"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"/dist/*",
		"/skill"
	],
	"scripts": {
		"build:lib": "pnpm clean && pnpm build:files && pnpm build:types",
		"build:files": "node ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"watch:lib": "node ./build.ts --watch",
		"clean": "rm -rf ./dist",
		"test:all": "vitest run",
		"lint-staged": "lint-staged",
		"check-types": "tsc --noEmit"
	},
	"lint-staged": {
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
			"oxlint",
			"prettier --write"
		],
		"**/*.{json,jsonc,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@standard-schema/spec": "^1.1.0",
		"@schema-engine/registry": "workspace:^"
	},
	"devDependencies": {
		"@schema-engine/scripts": "workspace:*",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"esbuild": "^0.27.0",
		"playwright": "^1.63.0",
		"tsc-alias": "^1.8.16",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "^4.0.17"
	},
	"peerDependencies": {
		"zod": "^4.0.17"
	}
}
