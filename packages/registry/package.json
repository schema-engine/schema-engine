{
	"name": "@schema-engine/registry",
	"type": "module",
	"version": "0.1.0",
	"license": "MIT",
	"sideEffects": false,
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"/dist/*"
	],
	"scripts": {
		"build:lib": "bun run clean && bun run build:files && bun run build:types",
		"build:files": "bun run ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"watch:lib": "bun run ./build.ts --watch",
		"clean": "rm -rf ./dist",
		"test:all": "bun test",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@ecopages/logger": "latest",
		"@standard-schema/spec": "^1.1.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"tsc-alias": "^1.8.16",
		"zod": "^4.0.17"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
