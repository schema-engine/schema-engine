{
	"name": "@schema-engine/registry",
	"type": "module",
	"version": "0.1.0",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"/dist/*"
	],
	"scripts": {
		"build:lib": "pnpm clean && pnpm build:files && pnpm build:types",
		"build:files": "node ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"watch:lib": "node ./build.ts --watch",
		"clean": "rm -rf ./dist",
		"test:all": "vitest run",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@ecopages/logger": "^0.2.2",
		"@standard-schema/spec": "^1.1.0"
	},
	"devDependencies": {
		"@schema-engine/scripts": "workspace:*",
		"esbuild": "^0.27.0",
		"tsc-alias": "^1.8.16",
		"vitest": "^4.0.13",
		"zod": "^4.0.17"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
