{
	"name": "@schema-engine/registry",
	"type": "module",
	"version": "0.1.0",
	"license": "MIT",
	"sideEffects": false,
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"/dist/*"
	],
	"scripts": {
		"build:lib": "bun run clean && bun run build:files && bun run build:types",
		"build:files": "bun run ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"watch:lib": "bun run ./build.ts --watch",
		"clean": "rm -rf ./dist",
		"test:all": "bun test",
		"lint-staged": "lint-staged"
	},
	"lint-staged": {
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
			"oxlint",
			"prettier --write"
		],
		"**/*.{json,jsonc,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@ecopages/logger": "latest"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"tsc-alias": "^1.8.16"
	},
	"peerDependencies": {
		"typescript": "^5",
		"zod": "^4.0.17"
	}
}
