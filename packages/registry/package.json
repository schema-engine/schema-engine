{
	"name": "@schema-engine/registry",
	"type": "module",
	"version": "0.5.2",
	"description": "The registration contract and registries of Schema Engine: documents name registrations by $type, and each registration validates its own configuration",
	"keywords": [
		"schema-engine",
		"registry",
		"json",
		"serialization",
		"standard-schema"
	],
	"author": "Andrea Zanenghi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/schema-engine/schema-engine.git",
		"directory": "packages/registry"
	},
	"engines": {
		"node": "^24.22.0 || >=26.0.0"
	},
	"homepage": "https://schema-engine.com/docs/registry/overview",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./json-schema": {
			"types": "./dist/json-schema/index.d.ts",
			"import": "./dist/json-schema/index.js"
		},
		"./yaml": {
			"types": "./dist/yaml/index.d.ts",
			"import": "./dist/yaml/index.js"
		}
	},
	"files": [
		"/dist/*",
		"/skill"
	],
	"scripts": {
		"build:lib": "pnpm clean && pnpm build:files && pnpm build:types",
		"build:files": "node ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"watch:lib": "node ./build.ts --watch",
		"clean": "rm -rf ./dist",
		"test:all": "vitest run",
		"check-types": "tsc --noEmit && node test/type-cost/check.ts"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.1.0"
	},
	"devDependencies": {
		"@schema-engine/scripts": "workspace:*",
		"ajv": "^8.20.0",
		"ajv-draft-04": "^1.0.0",
		"esbuild": "^0.27.0",
		"tsc-alias": "^1.8.16",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"yaml": "2.9.1",
		"zod": "^4.5.0"
	},
	"peerDependencies": {
		"yaml": "^2.8.0"
	},
	"peerDependenciesMeta": {
		"yaml": {
			"optional": true
		}
	}
}
