{
	"name": "@schema-engine/forms-radiant",
	"type": "module",
	"version": "0.5.0",
	"description": "The Radiant renderer for Schema Engine forms, with 18 ready elements built on Radiant UI",
	"keywords": [
		"schema-engine",
		"forms",
		"radiant",
		"ecopages",
		"web-components"
	],
	"author": "Andrea Zanenghi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/schema-engine/schema-engine.git",
		"directory": "packages/forms-radiant"
	},
	"engines": {
		"node": "^24.22.0 || >=26.0.0"
	},
	"homepage": "https://schema-engine.com/docs/forms-radiant/overview",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": [
		"**/*.css",
		"./dist/**/*.js"
	],
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"style": "dist/index.css",
	"files": [
		"/dist/*",
		"/skill"
	],
	"scripts": {
		"build:lib": "pnpm clean && pnpm build:files && pnpm build:types",
		"build:files": "node ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f",
		"watch:lib": "node ./build.ts --watch",
		"clean": "rm -rf ./dist",
		"test:all": "vitest run --project unit --project browser",
		"storybook": "storybook dev -p 6007 --no-open",
		"build-storybook": "storybook build -o ./storybook-static",
		"check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test-types.json",
		"test:storybook": "vitest run --project storybook"
	},
	"peerDependencies": {
		"@ecopages/jsx": ">=0.12.0",
		"@ecopages/radiant": ">=0.12.0",
		"@ecopages/radiant-ui": ">=0.6.1",
		"@ecopages/signals": ">=0.12.0",
		"@schema-engine/forms": "workspace:^",
		"@schema-engine/layout": "workspace:^",
		"zod": "^4.0.17"
	},
	"devDependencies": {
		"@babel/core": "^7.28.0",
		"@babel/plugin-proposal-decorators": "^7.28.0",
		"@babel/plugin-syntax-typescript": "^7.28.0",
		"@babel/plugin-transform-class-properties": "^7.28.0",
		"@ecopages/jsx": "0.12.0",
		"@ecopages/radiant": "0.12.0",
		"@ecopages/radiant-ui": "0.6.1",
		"@ecopages/signals": "0.12.0",
		"@ecopages/storybook-radiant-vite": "0.2.3",
		"@ecopages/vite-plugin-radiant": "0.2.3",
		"@rolldown/plugin-babel": "^0.2.1",
		"@schema-engine/forms": "workspace:^",
		"@schema-engine/layout": "workspace:^",
		"@schema-engine/scripts": "workspace:^",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.6.9",
		"@storybook/addon-vitest": "^10.6.9",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/user-event": "^14.6.6",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"esbuild": "^0.27.0",
		"nitro": "^3.0.260311-beta",
		"playwright": "^1.61.1",
		"storybook": "^10.6.9",
		"tsc-alias": "^1.8.16",
		"typescript": "catalog:",
		"vite": "^8.0.0",
		"vitest": "catalog:",
		"zod": "^4.0.17"
	},
	"dependencies": {
		"@ecopages/logger": "^0.2.3",
		"@schema-engine/actions": "workspace:^",
		"country-flag-icons": "^1.6.20",
		"imask": "^7.6.1",
		"libphonenumber-js": "^1.13.12"
	},
	"exports": {
		"./package.json": {
			"import": "./package.json"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./index.css": "./dist/index.css",
		"./primitives": {
			"types": "./dist/primitives.d.ts",
			"import": "./dist/primitives.js"
		},
		"./registrations": {
			"types": "./dist/registrations/elements.d.ts",
			"import": "./dist/registrations/elements.js"
		},
		"./hooks": {
			"types": "./dist/hooks/index.d.ts",
			"import": "./dist/hooks/index.js"
		},
		"./contexts": {
			"types": "./dist/contexts/index.d.ts",
			"import": "./dist/contexts/index.js"
		}
	}
}
