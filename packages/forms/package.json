{
	"name": "@schema-engine/forms",
	"type": "module",
	"version": "0.5.3",
	"description": "The forms domain of Schema Engine: JSON forms with elements, validation, constraints, steps, form state and submission, with no renderer",
	"keywords": [
		"schema-engine",
		"forms",
		"json",
		"validation",
		"wizard",
		"standard-schema"
	],
	"author": "Andrea Zanenghi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/schema-engine/schema-engine.git",
		"directory": "packages/forms"
	},
	"engines": {
		"node": "^24.22.0 || >=26.0.0"
	},
	"homepage": "https://schema-engine.com/docs/forms/overview",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"/dist/*",
		"/skill"
	],
	"scripts": {
		"build:lib": "pnpm clean && pnpm build:files && pnpm build:types",
		"build:files": "node ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"watch:lib": "node ./build.ts --watch",
		"clean": "rm -rf ./dist",
		"test:all": "vitest run",
		"lint-staged": "lint-staged",
		"check-types": "tsc --noEmit"
	},
	"lint-staged": {
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
			"oxlint",
			"prettier --write"
		],
		"**/*.{json,jsonc,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@schema-engine/scripts": "workspace:*",
		"ajv": "^8.20.0",
		"effect": "^3.22.1",
		"esbuild": "^0.27.0",
		"tsc-alias": "^1.8.16",
		"typescript": "catalog:",
		"valibot": "^1.4.2",
		"vitest": "catalog:",
		"yaml": "2.9.1"
	},
	"dependencies": {
		"@ecopages/logger": "^0.2.3",
		"@standard-schema/spec": "^1.1.0",
		"@schema-engine/actions": "workspace:^",
		"@schema-engine/layout": "workspace:^",
		"@schema-engine/registry": "workspace:^"
	},
	"peerDependencies": {
		"zod": "^4.5.0"
	},
	"exports": {
		"./package.json": {
			"import": "./package.json"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./default-elements": {
			"types": "./dist/default-elements/index.d.ts",
			"import": "./dist/default-elements/index.js"
		},
		"./browser": {
			"types": "./dist/browser/index.d.ts",
			"import": "./dist/browser/index.js"
		},
		"./state-container": {
			"types": "./dist/state-container/index.d.ts",
			"import": "./dist/state-container/index.js"
		},
		"./csrf": {
			"types": "./dist/csrf/index.d.ts",
			"import": "./dist/csrf/index.js"
		},
		"./server-errors": {
			"types": "./dist/server-errors/index.d.ts",
			"import": "./dist/server-errors/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./recipes": {
			"types": "./dist/recipes/index.d.ts",
			"import": "./dist/recipes/index.js"
		},
		"./recipes/built-in": {
			"types": "./dist/recipes/built-in.d.ts",
			"import": "./dist/recipes/built-in.js"
		},
		"./agent-tool": {
			"types": "./dist/agent-tool/index.d.ts",
			"import": "./dist/agent-tool/index.js"
		}
	}
}
