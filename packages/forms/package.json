{
	"name": "@schema-engine/forms",
	"type": "module",
	"version": "0.1.0",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"/dist/*"
	],
	"scripts": {
		"build:lib": "pnpm clean && pnpm build:files && pnpm build:types",
		"build:files": "node ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"watch:lib": "node ./build.ts --watch",
		"clean": "rm -rf ./dist",
		"test:all": "vitest run",
		"lint-staged": "lint-staged",
		"check-types": "tsc --noEmit"
	},
	"lint-staged": {
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
			"oxlint",
			"prettier --write"
		],
		"**/*.{json,jsonc,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@schema-engine/scripts": "workspace:*",
		"effect": "^3.22.1",
		"esbuild": "^0.27.0",
		"tsc-alias": "^1.8.16",
		"valibot": "^1.4.2",
		"vitest": "^4.0.13"
	},
	"dependencies": {
		"@ecopages/logger": "^0.2.2",
		"@standard-schema/spec": "^1.1.0",
		"@schema-engine/actions": "workspace:*",
		"@schema-engine/registry": "workspace:*"
	},
	"peerDependencies": {
		"typescript": "^5",
		"zod": "^4.0.17"
	},
	"exports": {
		"./package.json": {
			"import": "./package.json"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./actions": {
			"types": "./dist/actions/index.d.ts",
			"import": "./dist/actions/index.js"
		},
		"./actions/*": {
			"types": "./dist/actions/*.d.ts",
			"import": "./dist/actions/*.js"
		},
		"./actions/plugins/*": {
			"types": "./dist/actions/plugins/*.d.ts",
			"import": "./dist/actions/plugins/*.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js"
		},
		"./types/*": {
			"types": "./dist/types/*.d.ts",
			"import": "./dist/types/*.js"
		},
		"./builder": {
			"types": "./dist/builder/index.d.ts",
			"import": "./dist/builder/index.js"
		},
		"./builder/*": {
			"types": "./dist/builder/*.d.ts",
			"import": "./dist/builder/*.js"
		},
		"./engine": {
			"types": "./dist/engine/index.d.ts",
			"import": "./dist/engine/index.js"
		},
		"./engine/*": {
			"types": "./dist/engine/*.d.ts",
			"import": "./dist/engine/*.js"
		},
		"./schemas": {
			"types": "./dist/schemas/index.d.ts",
			"import": "./dist/schemas/index.js"
		},
		"./lib/debounce": {
			"types": "./dist/lib/debounce.d.ts",
			"import": "./dist/lib/debounce.js"
		},
		"./lib/standard-schema": {
			"types": "./dist/lib/standard-schema.d.ts",
			"import": "./dist/lib/standard-schema.js"
		},
		"./schemas/*": {
			"types": "./dist/schemas/*.d.ts",
			"import": "./dist/schemas/*.js"
		},
		"./schemas/validation": {
			"types": "./dist/schemas/validation/index.d.ts",
			"import": "./dist/schemas/validation/index.js"
		},
		"./schemas/validation/*": {
			"types": "./dist/schemas/validation/*.d.ts",
			"import": "./dist/schemas/validation/*.js"
		},
		"./schemas/validation/async/*": {
			"types": "./dist/schemas/validation/async/*.d.ts",
			"import": "./dist/schemas/validation/async/*.js"
		},
		"./constraints": {
			"types": "./dist/constraints/index.d.ts",
			"import": "./dist/constraints/index.js"
		},
		"./constraints/*": {
			"types": "./dist/constraints/*.d.ts",
			"import": "./dist/constraints/*.js"
		},
		"./tools": {
			"types": "./dist/tools/index.d.ts",
			"import": "./dist/tools/index.js"
		},
		"./tools/*": {
			"types": "./dist/tools/*.d.ts",
			"import": "./dist/tools/*.js"
		},
		"./recipes": {
			"types": "./dist/recipes/index.d.ts",
			"import": "./dist/recipes/index.js"
		},
		"./recipes/*": {
			"types": "./dist/recipes/*.d.ts",
			"import": "./dist/recipes/*.js"
		},
		"./lib/validate-form": {
			"types": "./dist/lib/validate-form.d.ts",
			"import": "./dist/lib/validate-form.js"
		},
		"./lib/field-scope": {
			"types": "./dist/lib/field-scope.d.ts",
			"import": "./dist/lib/field-scope.js"
		},
		"./lib/path-values": {
			"types": "./dist/lib/path-values.d.ts",
			"import": "./dist/lib/path-values.js"
		}
	}
}
