{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"rootDir": "./src",
		"outDir": "./dist",
		"noEmit": false,
		"declaration": true,
		"emitDeclarationOnly": true
	},
	"include": ["src"],
	"exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
