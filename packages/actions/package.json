{
	"name": "@schema-engine/actions",
	"type": "module",
	"version": "0.5.2",
	"description": "Registered actions that run from plain data: serializable workflows of sequential and parallel steps, checked before they run",
	"keywords": [
		"schema-engine",
		"actions",
		"workflow",
		"json",
		"serialization"
	],
	"author": "Andrea Zanenghi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/schema-engine/schema-engine.git",
		"directory": "packages/actions"
	},
	"homepage": "https://schema-engine.com/docs/actions/overview",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": {
			"import": "./package.json"
		}
	},
	"files": [
		"/dist/*",
		"/skill"
	],
	"scripts": {
		"build:lib": "pnpm clean && pnpm build:files && pnpm build:types",
		"build:files": "node ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node ../../scripts/resolve-declaration-specifiers.ts dist",
		"watch:lib": "node ./build.ts --watch",
		"clean": "rm -rf ./dist",
		"test:all": "vitest run",
		"lint-staged": "lint-staged",
		"check-types": "tsc --noEmit"
	},
	"lint-staged": {
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
			"oxlint",
			"prettier --write"
		],
		"**/*.{json,jsonc,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@ecopages/logger": "^0.2.3",
		"@schema-engine/registry": "workspace:^"
	},
	"devDependencies": {
		"@schema-engine/scripts": "workspace:^",
		"esbuild": "^0.27.0",
		"tsc-alias": "^1.8.16",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "^4.5.0"
	}
}
