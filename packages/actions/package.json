{
	"name": "@schema-engine/actions",
	"type": "module",
	"version": "0.1.0",
	"license": "MIT",
	"homepage": "https://schema-engine.ecopages.app/docs/actions/overview",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"/dist/*",
		"/skill"
	],
	"scripts": {
		"build:lib": "pnpm clean && pnpm build:files && pnpm build:types",
		"build:files": "node ./build.ts",
		"build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"watch:lib": "node ./build.ts --watch",
		"clean": "rm -rf ./dist",
		"test:all": "vitest run",
		"lint-staged": "lint-staged",
		"check-types": "tsc --noEmit"
	},
	"lint-staged": {
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
			"oxlint",
			"prettier --write"
		],
		"**/*.{json,jsonc,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@ecopages/logger": "^0.2.3",
		"@schema-engine/registry": "workspace:*"
	},
	"devDependencies": {
		"@schema-engine/scripts": "workspace:*",
		"esbuild": "^0.27.0",
		"tsc-alias": "^1.8.16",
		"vitest": "^4.0.13",
		"zod": "^4.0.17"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
