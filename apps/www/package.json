{
	"name": "@schema-engine/www",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"start": "NODE_ENV=production bun run app.ts",
		"dev": "NODE_ENV=development bun run app.ts --dev",
		"watch": "NODE_ENV=development bun --watch run app.ts --dev",
		"hot": "NODE_ENV=development bun --hot run app.ts --dev",
		"build": "PORT=4321 NODE_ENV=production bun run app.ts --build",
		"preview": "NODE_ENV=production bun run app.ts --preview",
		"watch:dev": "NODE_ENV=development bun --watch run app.ts --dev"
	},
	"dependencies": {
		"@base-ui/react": "^1.1.0",
		"@ecopages/logger": "^0.2.2",
		"@hookform/resolvers": "^5.2.2",
		"@radix-ui/react-slot": "^1.2.4",
		"@schema-engine/forms": "workspace:*",
		"@schema-engine/forms-react": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^0.562.0",
		"react": "^19",
		"react-day-picker": "^9.13.0",
		"react-dom": "^19",
		"react-hook-form": "^7.69.0",
		"react-resizable-panels": "^4.4.1",
		"recharts": "2.15.4",
		"rehype-pretty-code": "^0.14.1",
		"remark-gfm": "^4.0.1",
		"shadcn": "^3.7.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2",
		"zod": "^4.3.4"
	},
	"devDependencies": {
		"@ecopages/bun-postcss-loader": "npm:@jsr/ecopages__bun-postcss-loader@latest",
		"@ecopages/core": "npm:@jsr/ecopages__core@latest",
		"@ecopages/file-system": "npm:@jsr/ecopages__file-system@latest",
		"@ecopages/postcss-processor": "npm:@jsr/ecopages__postcss-processor@0.1.105",
		"@ecopages/react": "npm:@jsr/ecopages__react@latest",
		"@ecopages/react-router": "npm:@jsr/ecopages__react-router@latest",
		"@happy-dom/global-registrator": "^18.0.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@types/bun": "latest",
		"@types/node": "^22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.6",
		"postcss-import": "^16.1.1",
		"tailwindcss": "^4.1.18",
		"typescript": "^5"
	},
	"lint-staged": {
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
			"oxlint",
			"prettier --write"
		],
		"**/*.{json,jsonc,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"overrides": {
		"npm:react@^19": "react@^19"
