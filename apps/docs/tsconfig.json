{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@ecopages/jsx",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"noImplicitOverride": true,
		"paths": {
			"@/*": ["./src/*"],
			"@/components/ui/schema-engine/components/*": [
				"../../registry/base-ui/primitives/*",
				"../../registry/shared/primitives/*"
			],
			"@/components/schema-engine/forms/*": ["../../registry/shared/forms/*"],
			"@/components/ui/calendar": ["../../registry/shared/primitives/calendar.tsx"],
			"@/components/ui/*": ["../../packages/forms-react/.storybook/ui/*", "../../registry/ui-stubs/*"],
			"@/lib/utils": ["../../registry/ui-stubs/lib/utils.ts"]
		},
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2021",
		"types": ["node"],
		"useDefineForClassFields": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src", "eco.config.ts", "modules.d.ts"]
}
