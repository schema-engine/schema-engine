{
	"name": "@schema-engine/docs",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "pnpm build && ecopages start",
		"generate:llms": "tsx scripts/generate-llm-docs.ts",
		"predev": "pnpm generate:llms && pnpm --filter @schema-engine/forms-radiant --filter @schema-engine/forms-react build:lib",
		"dev": "ecopages dev",
		"prebuild": "pnpm generate:llms",
		"build": "ecopages build",
		"check-types": "pnpm build && tsc --noEmit && tsc --noEmit -p tsconfig.test-types.json",
		"preview": "ecopages preview",
		"test:e2e": "vitest run --project e2e",
		"pretest:e2e": "pnpm build",
		"test:browser": "vitest run --project browser",
		"test:unit": "vitest run --project unit"
	},
	"devDependencies": {
		"@ecopages/browser-router": "0.7.0",
		"@ecopages/content-processor": "0.7.0",
		"@ecopages/core": "0.7.0",
		"@ecopages/dev-toolbar": "0.7.0",
		"@ecopages/ecopages-jsx": "0.7.0",
		"@ecopages/file-system": "0.7.0",
		"@ecopages/jsx": "0.8.3",
		"@ecopages/postcss-processor": "0.7.0",
		"@ecopages/radiant": "0.8.3",
		"@ecopages/radiant-ui": "0.3.5",
		"@ecopages/react": "0.7.0",
		"@ecopages/scripts-injector": "^0.1.5",
		"@ecopages/signals": "0.8.3",
		"@mdx-js/esbuild": "^3.1.1",
		"@mdx-js/mdx": "^3.1.1",
		"@tailwindcss/postcss": "^4.0.0",
		"@types/hast": "^3.0.4",
		"@types/node": "^24.13.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@playwright/test": "^1.63.0",
		"@vitest/browser-playwright": "^4.0.13",
		"@testing-library/user-event": "^14.6.1",
		"ecopages": "0.6.1",
		"playwright": "^1.63.0",
		"rehype-pretty-code": "^0.14.1",
		"remark-gfm": "^4.0.1",
		"shiki": "^3.20.0",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.20.6",
		"typescript": "catalog:",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"vitest": "^4.1.11",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@schema-engine/forms": "workspace:*",
		"@schema-engine/forms-radiant": "workspace:*",
		"@schema-engine/forms-react": "workspace:*",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "4.1.0",
		"input-otp": "1.4.1",
		"radix-ui": "^1.6.7",
		"react": "^19.1.0",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.1.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	}
}
