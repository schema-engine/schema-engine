{
	"name": "@schema-engine/docs",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "pnpm build && ecopages start",
		"generate:llms": "tsx scripts/generate-llm-docs.ts",
		"copy:registry-demo": "tsx scripts/copy-registry-demo.ts",
		"copy:skill": "tsx scripts/copy-skill.ts",
		"postinstall": "pnpm copy:registry-demo && pnpm copy:skill",
		"dev": "pnpm generate:llms && pnpm copy:registry-demo && pnpm copy:skill && pnpm --filter @schema-engine/actions --filter @schema-engine/forms-radiant --filter @schema-engine/forms-react build:lib && ecopages dev",
		"build": "pnpm generate:llms && pnpm copy:registry-demo && pnpm copy:skill && ecopages build",
		"check-types": "pnpm build && tsc --noEmit && tsc --noEmit -p tsconfig.test-types.json",
		"preview": "ecopages preview",
		"test:e2e": "vitest run --project e2e",
		"pretest:e2e": "pnpm build",
		"test:browser": "vitest run --project browser",
		"test:unit": "vitest run --project unit",
		"test:all": "vitest run --project unit --project browser"
	},
	"devDependencies": {
		"@ecopages/browser-router": "^0.10.3",
		"@ecopages/content-processor": "^0.10.3",
		"@ecopages/core": "^0.10.3",
		"@ecopages/dev-toolbar": "^0.10.3",
		"@ecopages/ecopages-jsx": "^0.10.3",
		"@ecopages/file-system": "^0.10.3",
		"@ecopages/jsx": "^0.12.0",
		"@ecopages/lightningcss-processor": "^0.10.3",
		"@ecopages/radiant": "^0.12.0",
		"@ecopages/radiant-ui": "0.6.2",
		"@ecopages/react": "^0.10.3",
		"@ecopages/scripts-injector": "^0.1.5",
		"@ecopages/signals": "^0.12.0",
		"@mdx-js/esbuild": "^3.1.1",
		"@mdx-js/mdx": "^3.1.1",
		"@pierre/highlights": "^0.5.1",
		"@playwright/test": "^1.63.0",
		"@schema-engine/registry": "workspace:*",
		"@tailwindcss/node": "^4.1.18",
		"@tailwindcss/oxide": "^4.1.18",
		"@testing-library/user-event": "^14.6.1",
		"@types/canvas-confetti": "^1.9.0",
		"@types/hast": "^3.0.4",
		"@types/node": "^24.13.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/browser-playwright": "catalog:",
		"ecopages": "^0.10.3",
		"playwright": "^1.63.0",
		"remark-gfm": "^4.0.1",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.20.6",
		"typescript": "catalog:",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"vitest": "catalog:",
		"yaml": "2.9.1",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@base-ui/react": "^1.1.0",
		"@schema-engine/actions": "workspace:*",
		"@schema-engine/forms": "workspace:*",
		"@schema-engine/forms-radiant": "workspace:*",
		"@schema-engine/forms-react": "workspace:*",
		"@schema-engine/layout": "workspace:*",
		"canvas-confetti": "1.9.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "4.1.0",
		"input-otp": "1.4.1",
		"radix-ui": "^1.6.7",
		"react": "^19.1.0",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.1.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	}
}
