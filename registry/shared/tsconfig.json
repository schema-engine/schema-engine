{
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"@/*": ["../../packages/forms-react/src/*"],
			"@/components/ui/schema-engine/components/*": ["./primitives/*", "../base-ui/primitives/*"],
			"@/components/schema-engine/forms/*": ["./forms/*"],
			"@/components/ui/*": ["./ui-stubs/*", "../ui-stubs/*"],
			"@/lib/utils": ["../ui-stubs/lib/utils.ts"]
		}
	},
	"include": ["./forms/**/*.ts", "./forms/**/*.tsx", "./primitives/**/*.tsx", "./primitives/**/*.ts"]
}
