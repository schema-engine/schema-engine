{
	"oxc.enable": true,
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"oxc.requireConfig": false,
	"oxc.typeAware": true,
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[postcss]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	}
}
