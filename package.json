{
  "name": "form-engine",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@happy-dom/global-registrator": "^18.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "latest",
    "better-commits": "^1.18.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "build:lib": "bun build:lib:forms && bun build:lib:forms-react",
    "build:lib:forms": "bun run --filter @schema-engine/forms build:lib",
    "build:lib:forms-react": "bun run --filter @schema-engine/forms-react build:lib",
    "build:react-storybook": "NODE_OPTIONS='--max-old-space-size=4096' bun run --filter @schema-engine/forms-react build-storybook",
    "build:www": "bun run --filter @json-form-engine/www build",
    "changeset": "changeset",
    "clean": "clear && bunx npkill -D -y && rm -rf bun.lock && bun install",
    "commit": "better-commits",
    "dev:react-storybook": "bun run --elide-lines 0 --filter @schema-engine/forms-react storybook",
    "dev:www": "bun run --filter @json-form-engine/www dev",
    "hot:dev:www": "bun run --filter @json-form-engine/www hot:dev",
    "lint-staged:all": "bun run --filter '*' lint-staged",
    "prepare": "husky",
    "start:www": "bun run --filter @json-form-engine/www start",
    "test:all": "bun run --filter '*' test:all",
    "watch:dev:www": "bun run --filter @json-form-engine/www watch:dev"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "frimousse": "^0.3.0"
  }
}