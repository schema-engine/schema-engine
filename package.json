{
	"name": "form-engine",
	"module": "index.ts",
	"type": "module",
	"packageManager": "pnpm@10.15.1",
	"engines": {
		"node": ">=22.18.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.7",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"better-commits": "^1.18.1",
		"esbuild": "^0.27.0",
		"husky": "^9.0.11",
		"lint-staged": "^15.2.7",
		"oxlint": "latest",
		"oxlint-tsgolint": "latest",
		"prettier": "^3.4.2",
		"turbo": "^2.7.3",
		"typescript": "catalog:",
		"vitest": "^4.0.13"
	},
	"peerDependencies": {
		"typescript": "catalog:"
	},
	"scripts": {
		"build:lib": "turbo build:lib && turbo check-types",
		"build:lib:actions": "turbo run @schema-engine/actions#build:lib",
		"build:lib:forms": "turbo run @schema-engine/forms#build:lib",
		"build:lib:forms-react": "turbo run @schema-engine/forms-react#build:lib",
		"build:lib:forms-radiant": "turbo run @schema-engine/forms-radiant#build:lib",
		"build:lib:registry": "turbo run @schema-engine/registry#build:lib",
		"build:react-storybook": "NODE_OPTIONS='--max-old-space-size=4096' turbo run @schema-engine/forms-react#build-storybook",
		"build:docs": "turbo run @schema-engine/docs#build",
		"changeset": "changeset",
		"check-types:scripts": "tsc --noEmit -p scripts/tsconfig.json",
		"clean": "clear && pnpm dlx npkill -D -y && rm -rf pnpm-lock.yaml && pnpm install",
		"commit": "better-commits",
		"dev:react-storybook": "turbo run @schema-engine/forms-react#storybook",
		"dev:radiant-storybook": "turbo run @schema-engine/forms-radiant#storybook",
		"dev:docs": "turbo run @schema-engine/docs#dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint --type-aware",
		"lint-staged": "lint-staged",
		"lint-staged:all": "turbo lint-staged",
		"prepare": "husky",
		"preview:docs": "turbo run @schema-engine/docs#preview",
		"registry:generate": "node scripts/generate-schema-engine-registry.ts",
		"registry:check": "node scripts/generate-schema-engine-registry.ts --check",
		"registry:validate": "node scripts/generate-schema-engine-registry.ts --check && pnpm dlx shadcn@latest registry validate ./registry.json",
		"start:docs": "turbo run @schema-engine/docs#start",
		"test:all": "turbo test:all"
	},
	"dependencies": {
		"baseline-browser-mapping": "^2.10.42",
		"caniuse-lite": "^1.0.30001803",
		"frimousse": "^0.3.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"lint-staged": {
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
			"oxlint",
			"prettier --write"
		],
		"**/*.{json,jsonc,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"pnpm": {
		"overrides": {
			"react": "^19.1.0",
			"react-dom": "^19.1.0"
		},
		"onlyBuiltDependencies": [
			"core-js-pure",
			"esbuild",
			"msw"
		]
	}
}
