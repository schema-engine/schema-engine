{
	"name": "form-engine",
	"module": "index.ts",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.7",
		"@happy-dom/global-registrator": "^18.0.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@types/bun": "latest",
		"husky": "^9.0.11",
		"lint-staged": "^15.2.7"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"scripts": {
		"prepare": "husky",
		"build:lib": "bun run --elide-lines 0 --filter @json-form-engine/core build:lib && bun run --elide-lines 0 --filter @json-form-engine/react build:lib",
		"watch:dev:www": "bun run --elide-lines 0 --filter @json-form-engine/www watch:dev",
		"hot:dev:www": "bun run --elide-lines 0 --filter @json-form-engine/www hot:dev",
		"dev:www": "bun run --elide-lines 0 --filter @json-form-engine/www dev",
		"dev:react-storybook": "bun run --elide-lines 0 --filter @json-form-engine/react storybook",
		"build:react-storybook": "bun run --elide-lines 0 --filter @json-form-engine/react build-storybook",
		"build:www": "bun run --filter @json-form-engine/www build",
		"start:www": "bun run --filter @json-form-engine/www start",
		"test:all": "bun run --filter '*' test:all",
		"lint-staged:all": "bun run --filter '*' lint-staged",
		"clean": "clear && bunx npkill -D -y && rm -rf bun.lock && bun install",
		"changeset": "changeset"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}