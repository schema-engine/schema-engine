{
	"name": "form-engine",
	"module": "index.ts",
	"type": "module",
	"packageManager": "bun@1.3.4",
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.7",
		"@happy-dom/global-registrator": "^18.0.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@types/bun": "latest",
		"better-commits": "^1.18.1",
		"husky": "^9.0.11",
		"lint-staged": "^15.2.7",
		"oxlint": "latest",
		"oxlint-tsgolint": "latest",
		"prettier": "^3.4.2",
		"turbo": "^2.7.3"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"scripts": {
		"build:lib": "turbo build:lib check-types",
		"build:lib:actions": "turbo run @schema-engine/actions#build:lib",
		"build:lib:forms": "turbo run @schema-engine/forms#build:lib",
		"build:lib:forms-react": "turbo run @schema-engine/forms-react#build:lib",
		"build:lib:registry": "turbo run @schema-engine/registry#build:lib",
		"build:react-storybook": "NODE_OPTIONS='--max-old-space-size=4096' turbo run @schema-engine/forms-react#build-storybook",
		"build:www": "turbo run @schema-engine/www#build",
		"changeset": "changeset",
		"clean": "clear && bunx npkill -D -y && rm -rf bun.lock && bun install",
		"commit": "better-commits",
		"dev:react-storybook": "turbo run @schema-engine/forms-react#storybook",
		"dev:www": "turbo run @schema-engine/www#dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"hot:dev:www": "turbo run @schema-engine/www#hot:dev",
		"lint": "oxlint --type-aware",
		"lint-staged": "lint-staged",
		"lint-staged:all": "turbo lint-staged",
		"prepare": "husky",
		"start:www": "turbo run @schema-engine/www#start",
		"test:all": "turbo test:all",
		"watch:dev:www": "turbo run @schema-engine/www#watch:dev"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"frimousse": "^0.3.0"
	},
	"lint-staged": {
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
			"oxlint",
			"prettier --write"
		],
		"**/*.{json,jsonc,md,yml,yaml}": [
			"prettier --write"
		]
	}
}
