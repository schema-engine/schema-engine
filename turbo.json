{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build:lib": {
			"dependsOn": ["^build:lib"],
			"outputs": ["dist/**"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".eco/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"lint-staged": {
			"dependsOn": ["^lint-staged"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"storybook": {
			"cache": false,
			"persistent": true
		},
		"build-storybook": {
			"outputs": ["storybook-static/**"]
		},
		"test:storybook": {
			"dependsOn": ["^build:lib"]
		},
		"test:all": {
			"dependsOn": ["^test:all"]
		}
	}
}
