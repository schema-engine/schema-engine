{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build:lib": {
			"dependsOn": ["^build:lib"],
			"outputs": ["dist/**"]
		},
		"build": {
			"dependsOn": ["^build", "^build:lib"],
			"outputs": [".eco/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types", "^build:lib"]
		},
		"lint-staged": {
			"dependsOn": ["^lint-staged"]
		},
		"dev": {
			"dependsOn": ["^build:lib"],
			"persistent": true,
			"cache": false
		},
		"storybook": {
			"dependsOn": ["^build:lib"],
			"cache": false,
			"persistent": true
		},
		"build-storybook": {
			"dependsOn": ["^build:lib"],
			"outputs": ["storybook-static/**"]
		},
		"test:storybook": {
			"dependsOn": ["^build:lib"]
		},
		"test:all": {
			"dependsOn": ["^build:lib", "^test:all"]
		},
		"test:e2e": {
			"dependsOn": ["^build:lib", "build"],
			"cache": false
		},
		"preview": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"dependsOn": ["^build:lib"],
			"persistent": true
		},
		"@schema-engine/docs#build": {
			"dependsOn": ["^build", "^build:lib"],
			"outputs": [".eco/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/registry.json",
				"$TURBO_ROOT$/registry/**",
				"$TURBO_ROOT$/packages/forms-react/.storybook/ui/**"
			]
		},
		"@schema-engine/docs#check-types": {
			"dependsOn": ["^check-types", "^build:lib"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/registry.json",
				"$TURBO_ROOT$/registry/**",
				"$TURBO_ROOT$/packages/forms-react/.storybook/ui/**"
			]
		},
		"@schema-engine/docs#test:all": {
			"dependsOn": ["^build:lib", "^test:all"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/registry.json",
				"$TURBO_ROOT$/registry/**",
				"$TURBO_ROOT$/packages/forms-react/.storybook/ui/**"
			]
		},
		"@schema-engine/registry#test:all": {
			"dependsOn": ["build:lib", "^test:all"]
		}
	}
}
